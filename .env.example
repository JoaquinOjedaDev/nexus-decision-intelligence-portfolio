# Copy to .env for local use. Never commit the resulting file.
NEXUS_ENV=dev
NEXUS_DATA_PROFILE=smoke
NEXUS_LOG_LEVEL=INFO

POSTGRES_USER=nexus
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=nexus
NEXUS_POSTGRES_PORT=55432

# R6 only; the R0/R1 path must work without this value.
NEXUS_LLM_API_KEY=
