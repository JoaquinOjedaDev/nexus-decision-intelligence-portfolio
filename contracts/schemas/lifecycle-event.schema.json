{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/lifecycle-event/1.0",
  "title": "LifecycleEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.[0-9]+$", "default": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": { "enum": ["submitted_for_approval", "approval_granted", "approval_rejected", "approval_expired", "invalidated", "execution_requested", "execution_succeeded", "execution_failed", "outcome_observed"] },
    "manifest_id": { "type": "string", "format": "uuid" },
    "manifest_fingerprint": { "$ref": "#/$defs/sha256" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor_id": { "$ref": "#/$defs/identifier" },
    "actor_role": { "enum": ["planner", "approver", "auditor", "system"] },
    "correlation_id": { "$ref": "#/$defs/identifier" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "approval_expires_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "default": null },
    "external_reference": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }], "default": null },
    "outcome_snapshot": { "anyOf": [{ "type": "object" }, { "type": "null" }], "default": null },
    "outcome_metrics": { "type": "array", "default": [] }
  },
  "required": ["event_id", "sequence", "event_type", "manifest_id", "manifest_fingerprint", "occurred_at", "actor_id", "actor_role", "correlation_id", "reason"],
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "approval_granted" } }, "required": ["event_type"] },
      "then": {
        "required": ["approval_expires_at"],
        "properties": { "approval_expires_at": { "type": "string", "format": "date-time" } }
      },
      "else": { "properties": { "approval_expires_at": { "type": "null" } } }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["execution_succeeded", "execution_failed"] } }, "required": ["event_type"] },
      "then": {
        "required": ["external_reference"],
        "properties": { "external_reference": { "$ref": "#/$defs/identifier" } }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "outcome_observed" } }, "required": ["event_type"] },
      "then": {
        "required": ["outcome_snapshot", "outcome_metrics"],
        "properties": {
          "outcome_snapshot": { "$ref": "#/$defs/snapshot" },
          "outcome_metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } }
        }
      },
      "else": {
        "properties": {
          "outcome_snapshot": { "type": "null" },
          "outcome_metrics": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$", "minLength": 1, "maxLength": 160 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": { "$ref": "#/$defs/identifier" },
        "snapshot_id": { "$ref": "#/$defs/identifier" },
        "schema_version": { "$ref": "#/$defs/identifier" },
        "as_of": { "type": "string", "format": "date-time" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "row_count": { "type": "integer", "minimum": 0 },
        "partition_keys": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "default": [] }
      },
      "required": ["dataset", "snapshot_id", "schema_version", "as_of", "content_sha256", "row_count"]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/identifier" }
      },
      "required": ["name", "value", "unit"]
    }
  }
}
